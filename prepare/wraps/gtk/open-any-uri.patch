gdkandroidinit: deliver non-SAF uris to GApplication::open

GdkContext.open converted every incoming Uri through
gdk_android_content_file_from_uri, which only accepts SAF document/tree
uris and returns NULL (with a critical) for everything else — so VIEW
intents carrying custom schemes (OAuth/OIDC redirect callbacks), http
links or plain content shares handed g_application_open a NULL file.
Keep the ContentResolver-backed GFile for SAF uris and describe any
other uri by string, the same way the other backends do.

diff --git a/gdk/android/gdkandroidinit.c b/gdk/android/gdkandroidinit.c
--- a/gdk/android/gdkandroidinit.c
+++ b/gdk/android/gdkandroidinit.c
@@ -87,11 +87,23 @@
   GApplication *app = g_application_get_default ();
   if (g_application_get_flags (app) & G_APPLICATION_HANDLES_OPEN)
     {
-      GFile *file = gdk_android_content_file_from_uri (uri);
+      (*env)->PushLocalFrame (env, 2);
+      jstring uri_string = (*env)->CallObjectMethod (env, uri, gdk_android_get_java_cache ()->j_object.to_string);
+      gchar *uri_utf8 = gdk_android_java_to_utf8 (uri_string, NULL);
+      // Only SAF uris get the ContentResolver-backed GFile;
+      // gdk_android_content_file_from_uri rejects anything else, which
+      // still has to be delivered (custom schemes, http, plain shares).
+      GFile *file = g_str_has_prefix (uri_utf8, "content:")
+                        ? gdk_android_content_file_from_uri (uri)
+                        : NULL;
+      if (file == NULL)
+        file = g_file_new_for_uri (uri_utf8);
       gchar *hint = gdk_android_java_to_utf8 (jhint, NULL);
       g_application_open (app, &file, 1, hint);
       g_free (hint);
+      g_free (uri_utf8);
       g_object_unref (file);
+      (*env)->PopLocalFrame (env, NULL);
     }
   else
     {
